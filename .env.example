# Copy this file to ".env" (same folder) and fill what you want. All keys are optional and free.

# Indeed + Glassdoor + Bayt + GulfTalent + LinkedIn + ZipRecruiter ... through one API (Google for Jobs).
# Sign up (free, ~200 requests/month): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  -> "Subscribe to Test" -> copy X-RapidAPI-Key
JSEARCH_KEY=
JSEARCH_MAX=30

# Jooble (aggregates many Gulf / Turkey / Malaysia boards) - free key: https://jooble.org/api/about
JOOBLE_KEY=

# Adzuna - free keys: https://developer.adzuna.com
ADZUNA_ID=
ADZUNA_KEY=

# LinkedIn public search pages are read by default (a few polite requests). Set to off to disable.
# LINKEDIN=off
